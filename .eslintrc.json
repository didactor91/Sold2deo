{
  "env": { "browser": true, "es2022": true, "node": true },
  "extends": "eslint:recommended",
  "parserOptions": { "sourceType": "module" },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "max-len": ["error", { "code": 300 }],
    "max-depth": ["error", 3],
    "max-lines-per-function": ["error", 40]
  },
  "overrides": [
    {
      "files": ["tests/**/*.test.js"],
      "rules": {
        "max-lines-per-function": ["error", 500]
      }
    }
  ]
}