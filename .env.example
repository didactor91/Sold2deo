# Weld Master — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://weldmaster:weldpass@localhost:5432/weldmaster

# Server
PORT=3001
NODE_ENV=development

# JWT (generate a secure random string for production)
JWT_SECRET=weldmaster-jwt-secret-change-in-production

# Frontend (for CORS in production)
FRONTEND_URL=http://localhost:3000
